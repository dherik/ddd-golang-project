meta {
  name: Login
  type: http
  seq: 1
}

docs {
  A failed login returns 401 with the message "invalid credentials" for both an unknown username and a wrong password.
}

post {
  url: http://localhost:3333/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "some_password"
  }
}

body:multipart-form {
  username: admin
  password: some_password
}

vars:post-response {
  token: res.body.token
}

script:post-response {
    bru.setEnvVar("token", res.body.token);
}
